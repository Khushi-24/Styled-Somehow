DB_URL=jdbc:mysql://localhost:3306/styled_somehow
MEDIA_DIRECTORY=./storage/production-media
STORE_URL=https://styledsomehow.in
COOKIE_SECURE=true
# Production startup requires configured SMTP and confirmations enabled.
# Replace media path with a persistent absolute directory on the server.
# Java properties format: no export prefix or surrounding quotes.
# Keep secrets private. Backslashes must be escaped as \\ in values.
DB_USERNAME=styled_app
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
ORDER_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Razorpay TEST credentials for rehearsal; live requires explicit approval.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_LIVE_ENABLED=false

SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_POSTCODE=380015
SHIPROCKET_PICKUP_LOCATION=Home
SHIPROCKET_BOOKING_ENABLED=false

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
ORDER_CONFIRMATION_EMAIL_ENABLED=false
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
